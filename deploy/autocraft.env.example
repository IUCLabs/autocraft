# Settings of a production install, read by the systemd units and deploy/hook.sh.
# Copy to <root>/config/autocraft.env and replace @ROOT@ (install root, the app
# user's home) and @BASE_URL@ (public origin, https, no path). One KEY=VALUE per
# line, no quotes and no spaces in values: systemd and the hook's shell both read it.

# Dashboard
CRAFT_AUTO_BASE_URL=@BASE_URL@
CRAFT_AUTO_LISTEN=127.0.0.1:3005
CRAFT_AUTO_TRUST_PROXY=1
CRAFT_AUTO_SECRETS_FILE=@ROOT@/config/secrets.json

# Data and caches. XDG_CACHE_HOME covers the embedding model, image proxy and label caches.
CRAFT_AUTO_DB=@ROOT@/data/mirror.db
XDG_CACHE_HOME=@ROOT@/cache
CRAFT_AUTO_LOCK_DIR=@ROOT@/cache/locks
CRAFT_AUTO_RUNNER_LOGS=@ROOT@/cache/jobs
CRAFT_AUTO_DIFF_CACHE=@ROOT@/cache/diffs
CRAFT_AUTO_CHECKOUT_DIR=@ROOT@/cache/checkouts
CRAFT_AUTO_FIXUP_DIR=@ROOT@/cache/fixups
CRAFT_AUTO_MODEL_CACHE=@ROOT@/cache/models

# Runner and sandbox worker
CRAFT_AUTO_WORKER_LISTEN=127.0.0.1:8981
CRAFT_AUTO_ACCOUNTS=@ROOT@/config/accounts.json

# deploy/hook.sh
AUTOCRAFT_BRANCH=main
