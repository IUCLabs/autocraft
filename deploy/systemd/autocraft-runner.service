# Replace @ROOT@ (install root) and @USER@ (app user), copy to /etc/systemd/system/, then
# systemctl daemon-reload && systemctl enable --now <unit>. All settings come from
# @ROOT@/config/autocraft.env (README, "Production install").
[Unit]
Description=AutoCraft pipeline runner (also serves the worker API)
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@ROOT@/app
EnvironmentFile=@ROOT@/config/autocraft.env
Environment=PATH=@ROOT@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node --no-warnings @ROOT@/app/src/cli.ts runner serve
Restart=on-failure
RestartSec=10
# SIGTERM stops the jobs (10 s each to end); the rest is killed after the stop timeout.
KillMode=mixed
TimeoutStopSec=30
# Lighter than the dashboard: jobs run git, gh, claude (in bubblewrap) and jev.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
